# Cloudflare Worker Local Environment Secrets (.dev.vars.example)
# Place real local values in .dev.vars (which is gitignored)

TURSO_DATABASE_URL="https://your-db-name.turso.io"
TURSO_AUTH_TOKEN="your_turso_auth_token"
CLERK_SECRET_KEY="sk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."
OPENAI_API_KEY="sk-proj-..."
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
R2_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID"
R2_ACCESS_KEY_ID="YOUR_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="YOUR_R2_SECRET_ACCESS_KEY"
R2_BUCKET_NAME="nocus"
R2_PUBLIC_URL="https://YOUR_R2_PUBLIC_URL"
ALLOWED_ORIGINS="http://localhost:5173,https://localhost"
